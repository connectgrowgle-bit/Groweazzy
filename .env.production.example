APP_ENV=production
APP_URL=https://groweazzy.example

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/groweazzy_production
DATABASE_SSL=true

SESSION_SECRET=
PII_ENCRYPTION_KEY=

PAYMENT_PROVIDER=razorpay
PAYMENT_MODE=live
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CRON_SECRET=

EMAIL_PROVIDER=resend
STORAGE_DRIVER=s3
# Required in production — src/lib/env.ts refuses to boot without it.
SENTRY_DSN=
# Must be a header the platform itself overwrites (e.g. your reverse proxy's
# own injected header), never one a client can set directly.
TRUSTED_PROXY_HEADER=
