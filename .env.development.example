# Copy to .env.local for local development. See docs/ARCHITECTURE.md and
# src/lib/env.ts for what each of these does and how they're cross-checked.

APP_ENV=development
APP_URL=http://localhost:3000

# No ?schema= param — Drizzle tolerates it, pg_dump rejects it.
DATABASE_URL=postgres://groweazzy:groweazzy@localhost:5432/groweazzy_dev
DATABASE_SSL=false

# openssl rand -base64 48
SESSION_SECRET=

# openssl rand -hex 32 — rotating this breaks existing KYC records (no
# re-encryption tooling yet, see docs/ARCHITECTURE.md §15).
PII_ENCRYPTION_KEY=

# Use the mock gateway until Phase 5/13 wire up real Razorpay test keys.
PAYMENT_PROVIDER=mock
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# openssl rand -hex 32
CRON_SECRET=

EMAIL_PROVIDER=console
STORAGE_DRIVER=local
SENTRY_DSN=
TRUSTED_PROXY_HEADER=
