APP_ENV=staging
APP_URL=https://staging.groweazzy.example

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/groweazzy_staging
DATABASE_SSL=true

SESSION_SECRET=
PII_ENCRYPTION_KEY=

# Real Razorpay TEST keys against real endpoints — this is where Phase 13
# (real gateway verification) runs.
PAYMENT_PROVIDER=razorpay
PAYMENT_MODE=test
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CRON_SECRET=

EMAIL_PROVIDER=resend
STORAGE_DRIVER=s3
SENTRY_DSN=
TRUSTED_PROXY_HEADER=
